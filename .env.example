# Partner-ID des Frontends bei der Alpha-Trader-API. Öffentlich, landet im Bundle.
# PARTNER_ID reicht; VITE_PARTNER_ID hat Vorrang, falls gesetzt.
PARTNER_ID=
VITE_PARTNER_ID=

# API-Server: stable (echtes Spiel), nightly oder dev
VITE_API_BASE=https://stable.alpha-trader.com

# Nur für die Entwickler-Skripte (api:get, shot, audit) – nie committen.
AT_USERNAME=
AT_PASSWORD=

# Anbieter für /impressum und /datenschutz. Nur hier bzw. in der .env auf dem Pi – nie ins Repo.
# Der Container schreibt daraus beim Start /legal.json (docker/40-legal-config.sh).
LEGAL_NAME=
LEGAL_STREET=
# PLZ und Ort, z. B. „12345 Musterstadt“
LEGAL_CITY=
LEGAL_COUNTRY=Deutschland
LEGAL_EMAIL=
# optional
LEGAL_PHONE=
# Wo die Seite läuft, ein Satz für die Datenschutzerklärung, z. B.
# „auf einem eigenen Server (Raspberry Pi) in Deutschland, erreichbar über Cloudflare Tunnel (Cloudflare Inc., USA)“
LEGAL_HOSTING=

# Feedback-Dienst: Spielernamen, die /experimente sehen dürfen
FEEDBACK_ADMINS=
