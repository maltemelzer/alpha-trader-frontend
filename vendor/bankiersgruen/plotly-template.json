            "width": 1
          },
          "fillcolor": "#7FD1A3"
        },
        "decreasing": {
          "line": {
            "color": "#EB7A6B",
            "width": 1
          },
          "fillcolor": "#EB7A6B"
        }
      }
    ],
    "pie": [
      {
        "hole": 0.64,
        "sort": false,
        "direction": "clockwise",
        "marker": {
          "line": {
            "color": "#182A22",
            "width": 2
          }
        },
        "textposition": "outside",
        "outsidetextfont": {
          "family": "\"IBM Plex Mono\", \"JetBrains Mono\", ui-monospace, Menlo, monospace",
          "size": 12,
          "color": "#9AA898"
        }
      }
    ],
    "bar": [
      {
        "marker": {
          "line": {
            "color": "#182A22",
            "width": 2
          }
        }
      }
    ]
