{
  "name": "alpha-trader-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Inoffizielles, visualisierungsstarkes Web-Frontend für die Börsensimulation Alpha-Trader",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/maltemelzer/alpha-trader-frontend.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "api:generate": "openapi-typescript https://stable.alpha-trader.com/v3/api-docs -o src/api/schema.d.ts",
    "api:get": "node scripts/api-get.mjs",
    "ds:tokens": "node scripts/design-system.mjs",
    "shot": "node scripts/shot.mjs",
    "audit": "node scripts/audit.mjs"
  },
  "dependencies": {
    "@stomp/stompjs": "^7.3.0",
    "@tanstack/react-query": "^5.103.2",
    "openapi-fetch": "^0.17.0",
    "plotly.js-dist-min": "^3.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "openapi-typescript": "^7.13.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
